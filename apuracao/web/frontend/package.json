{
  "name": "apuracao-frontend",
  "private": true,
  "type": "module",
  "description": "Página do site de apuração (fonte). O build vai para ../static, servido pelo FastAPI.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "verificar": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/public-sans": "5.3.0",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "20.19.43",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
